---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import PhotoStrip from '../components/PhotoStrip.astro';
import photos from '../data/selected-photos.json';
const base = import.meta.env.BASE_URL;
---
<Base page="exploration" titleEn="Hyukjoon John Lee | Exploration" titleKo="이혁준 | Exploration" descriptionEn="Running, jazz, community, reading and writing." descriptionKo="달리기와 재즈, 사람들과 함께하는 시간, 읽고 쓰는 기록.">
  <div class="page-wrap interior-page exploration-page">
    <div class="eyebrow">PERSONAL INTERESTS</div>
    <div class="page-heading"><h1>Exploration</h1><p><T en="Things I return to, explore, and enjoy." ko="좋아하는 것을 찾아가고 이어온 기록입니다." /></p></div>
    <section class="explore-row"><div class="explore-gallery running-gallery"><PhotoStrip photos={photos.running} label="마라톤 사진" /></div><div><div class="explore-label">01 / RUNNING</div><h2><T en="Running as a Lifestyle" ko="라이프스타일로서의 러닝" /></h2><p><T en="I pursue running as a lifestyle. I have completed three full marathons." ko="라이프스타일로서의 러닝을 추구합니다. 풀마라톤을 3회 완주했습니다." /></p></div></section>
    <section class="explore-row"><div class="explore-gallery jazz-gallery"><div class="explore-label">02 / JAZZ</div><PhotoStrip photos={photos.jazz} label="재즈 공연과 재즈바 사진" /></div><div><h2>Jazz</h2><p><T en="I am drawn to jazz because the same piece can become something different with each performer and each moment. I want to understand the musicians’ language, not only listen from the outside, and to express myself through that language someday. To me, jazz is both a way of listening and a way of living: a practice in curiosity, expression, and being open to what happens next." ko="재즈가 좋은 이유는 같은 곡도 누가 연주하는지, 또 같은 연주자도 그 순간 어떻게 표현하는지에 따라 매번 달라지기 때문입니다. 듣는 데 머무르지 않고 연주자들의 언어를 더 깊이 이해하고, 언젠가는 그 언어로 저를 표현하고 싶습니다. 재즈를 하나의 언어이자 삶의 태도로 받아들이며, 조금 더 ‘째—지하게’ 살고 싶습니다." /></p><a class="secondary-link" href={`${base}thoughts/live-jazzy/`}><T en="Read the story" ko="째—지하게 살고 싶다" /> →</a></div></section>
    <section class="explore-row explore-reverse"><div class="explore-gallery"><PhotoStrip photos={[...photos.community, photos.medted[1]]} label="함께 배우고 나눈 모임과 MedTED 발표 사진" /></div><div><div class="explore-label">03 / COMMUNITY</div><h2>Building Community</h2><p><T en="For two years, I planned and hosted reflection gatherings using the [연말정산] year-end review booklet. I enjoy making room for people to look back together, share what mattered, and carry their reflections into what comes next." ko="2년 동안 [연말정산] 책자를 활용한 회고 모임을 기획하고 진행했습니다. 함께 한 해를 돌아보고, 각자에게 의미 있었던 일을 나누며, 다음을 생각해볼 수 있는 자리를 만들었습니다." /></p></div></section>
    <section class="explore-row"><div class="explore-gallery reading-gallery"><PhotoStrip photos={photos.reading} label="읽기와 모임 사진" /></div><div><div class="explore-label">04 / NOTES</div><h2>Reading &amp; Writing</h2><p><T en="Notes on reading, exploring, and finding what interests me." ko="읽고 탐험하며 관심사를 찾아가는 과정을 글로 남깁니다." /></p><a class="secondary-link" href={`${base}thoughts/`}><T en="Read the journal" ko="글 읽기" /> →</a></div></section>
  </div>
</Base>
