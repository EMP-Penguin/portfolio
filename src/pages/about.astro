---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
const base = import.meta.env.BASE_URL;
---
<Base page="about" titleEn="Hyukjoon John Lee | About" titleKo="이혁준 | About" descriptionEn="My story and interests." descriptionKo="이혁준이 걸어온 길과 관심사.">
  <section id="about" class="page-wrap interior-page about-section">
    <div class="eyebrow">ABOUT</div>
    <div class="page-heading"><h2>About</h2></div>
    <div class="about-body">
      <p><T
        en="I graduated from the Korea Military Academy in 2022, was commissioned as an Army officer, and currently serve on active duty as a captain. My interest in saving lives on the battlefield led me to pursue military medicine and trauma care. I am now studying at Yonsei University College of Medicine as an Army-sponsored student, with the hope of becoming an expert in these fields."
        ko="2022년 육군사관학교를 졸업하고 육군 장교로 임관해 현역 대위로 복무 중입니다. 전장에서 사람을 살리는 일에 관심을 갖게 되었고, 군진의학과 외상 분야의 전문가가 되겠다는 꿈을 안고 연세대학교 의과대학에서 군위탁생으로 공부하고 있습니다."
      /></p>
      <p><T
        en="My interest in AI and data science has led me to activities including hackathons and AI study groups."
        ko="AI와 데이터과학에 대한 관심을 바탕으로 해커톤과 AI 활용 스터디 등 다양한 활동을 이어왔습니다."
      /></p>
      <p><T
        en="I want to pursue a vocation, not just a job. I do not want to define myself solely by being a doctor or a soldier; I want to do work that saves lives. I also spend time thinking about what it means to live authentically. I read, run, and listen to jazz."
        ko="직보다는 업을 추구하는 삶을 살고 싶습니다. 의사나 군인이라는 직업으로 저를 한정하기보다, 사람을 살리는 일을 하고 싶습니다. 실존적인 삶을 어떻게 살아갈지에도 관심이 많습니다. 읽고, 달리고, 재즈를 듣습니다."
      /></p>
      <a class="secondary-link" href={`${base}contacts/`}><T en="Get in touch" ko="연락하기" /> →</a>
    </div>
  </section>
</Base>
